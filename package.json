{
  "name": "store-kompascom",
  "version": "0.1.0",
  "private": true,
  "description": "Store Kompas.com — storefront SSR (Express + Handlebars) dengan MySQL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n app,css -c blue,magenta \"tsx watch --clear-screen=false src/server.ts\" \"npm:css:watch\"",
    "css": "sass --no-source-map --style=compressed assets/sass:public/css",
    "css:watch": "sass --no-source-map --watch assets/sass:public/css",
    "build": "npm run css && tsc -p tsconfig.json",
    "vercel-build": "node scripts/vercel-build.mjs",
    "postinstall": "prisma generate",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.2",
    "juice": "^12.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "purgecss": "^8.0.0",
    "sass": "^1.105.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.4"
  }
}
