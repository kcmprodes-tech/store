# Salin ke .env lalu isi kredensial lokal.
PORT=3000
NODE_ENV=development
DATABASE_URL="mysql://store_dev:password@localhost:3306/store_kompas"
# Prisma membuat shadow database saat `migrate dev`.
SHADOW_DATABASE_URL="mysql://store_dev:password@localhost:3306/store_kompas_shadow"

# Opsional (development): folder build prototipe untuk QA visual di /__prototipe
# PROTOTYPE_DIR=../dummy-kompascom-product/build

# Nomor WhatsApp store (format 62..., tanpa + dan 0). Kosong = tombol WhatsApp disembunyikan.
# Nanti bisa ditimpa dari CMS (settings.whatsapp_number).
WHATSAPP_NUMBER=
