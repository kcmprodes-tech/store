# Salin ke .env lalu isi kredensial lokal.
PORT=3000
NODE_ENV=development
DATABASE_URL="mysql://store_dev:password@localhost:3306/store_kompas"
# Prisma membuat shadow database saat `migrate dev`.
SHADOW_DATABASE_URL="mysql://store_dev:password@localhost:3306/store_kompas_shadow"

# Opsional (development): folder build prototipe untuk QA visual di /__prototipe
# PROTOTYPE_DIR=../dummy-kompascom-product/build

# Nomor WhatsApp store (format 62..., tanpa + dan 0). Kosong = tombol WhatsApp disembunyikan.
# Nanti bisa ditimpa dari CMS (settings.whatsapp_number).
WHATSAPP_NUMBER=

# Alamat publik aplikasi (tanpa / di akhir): link & gambar di email, QR pengambilan pesanan, passkey CMS.
# Default: http://localhost:<PORT>. Isi dengan domain/tunnel HTTPS saat diuji dari HP atau di hosting.
# (PUBLIC_BASE_URL masih dibaca sebagai nama lama.)
# APP_ORIGIN=https://store.kompas.com

# CMS (/admin). Admin pertama dibuat oleh `npm run db:seed` (wajib ganti password saat login pertama).
# Kosongkan password: seed membuat password acak dan menuliskannya ke .env.
# ADMIN_EMAIL=ardi.suhanda@kompas.com
# ADMIN_NAME=Ardi Suhanda
ADMIN_INITIAL_PASSWORD=
# Akun uji per peran (*@cms.test, hanya development).
CMS_TEST_PASSWORD=

# Database di cloud (mis. TiDB Cloud): tambahkan ?sslaccept=strict di DATABASE_URL untuk TLS.
# Ukuran pool koneksi (default 10; di Vercel cukup 5) dan CA tambahan bila server memakai CA sendiri.
# DATABASE_POOL_SIZE=5
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Proxy yang dipercaya untuk X-Forwarded-For/Proto. Default "loopback" (cloudflared/nginx di mesin yang sama).
# Di Vercel isi 1. Tanpa NODE_ENV aplikasi berjalan sebagai produksi (gagal-aman).
# TRUST_PROXY=loopback
# Akun uji *@cms.test hanya dibuat saat NODE_ENV=development/test, atau paksa dengan SEED_TEST_ACCOUNTS=1.
