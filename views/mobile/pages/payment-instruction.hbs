          <div class="od-item" data-instr="bca-va"><dt>No Virtual account</dt><dd data-pay-va>08777 1234 2345 4567</dd><button class="od-copy" type="button" data-copy="08777123423454567" data-pay-va-copy aria-label="Salin no virtual account" data-copy-toast="Nomor virtual account berhasil disalin"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1.5"></rect><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"></path></svg></button></div>
