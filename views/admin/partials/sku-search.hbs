{{!-- Pencarian SKU (stok dilacak). Parameter: label --}}
<div class="picker-search" data-sku-search>
  <div class="input-search">
    {{icon "magnifying-glass" size=18}}
    <input class="input" type="search" placeholder="Cari produk atau kode SKU…" autocomplete="off" aria-label="{{label}}" data-sku-search-input>
  </div>
  <div class="picker-results" data-sku-results hidden></div>
</div>
