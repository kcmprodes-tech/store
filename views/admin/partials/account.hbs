<div>
  <div class="adm-account">
    <span class="adm-avatar" aria-hidden="true">{{initials admin.name}}</span>
    <span class="adm-account-text"><strong>{{admin.name}}</strong><span>{{roleNames}}</span></span>
  </div>
  <div class="adm-account-actions">
    <a class="btn btn-secondary btn-sm" href="/admin/akun/password">{{icon "key" size=16}} Password</a>
    <form method="post" action="/admin/logout">
      {{> csrf}}
      <button class="btn btn-secondary btn-sm" type="submit">{{icon "sign-out" size=16}} Keluar</button>
    </form>
  </div>
</div>
