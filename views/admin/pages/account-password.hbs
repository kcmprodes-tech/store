<div class="page-head">
  <div class="page-head-text">
    <h1 class="page-title">Ganti password</h1>
    <p class="page-subtitle">{{admin.email}}</p>
  </div>
</div>

{{#if forced}}
<div class="alert alert-warning form-errors">{{icon "shield-warning" weight="fill"}}<div class="alert-body">Demi keamanan, ganti password sementara Anda sebelum memakai CMS.</div></div>
{{/if}}

<div class="box narrow">
  <form class="form-grid" method="post" action="/admin/akun/password" novalidate data-busy-form>
    {{> csrf}}
    <div class="field">
      <label class="label label-req" for="current">Password sekarang</label>
      <input class="input{{#if errors.current}} is-invalid{{/if}}" id="current" name="current" type="password" autocomplete="current-password" required>
      {{#if errors.current}}<p class="field-error">{{errors.current}}</p>{{/if}}
    </div>
    <div class="field">
      <label class="label label-req" for="password">Password baru</label>
      <input class="input{{#if errors.password}} is-invalid{{/if}}" id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
      {{#if errors.password}}<p class="field-error">{{errors.password}}</p>{{else}}<p class="help">Minimal 10 karakter. Gunakan kalimat yang mudah diingat tetapi sulit ditebak.</p>{{/if}}
    </div>
    <div class="field">
      <label class="label label-req" for="confirm">Ulangi password baru</label>
      <input class="input{{#if errors.confirm}} is-invalid{{/if}}" id="confirm" name="confirm" type="password" autocomplete="new-password" required>
      {{#if errors.confirm}}<p class="field-error">{{errors.confirm}}</p>{{/if}}
    </div>
    <div class="row">
      <button class="btn btn-primary" type="submit">{{icon "check" size=18}} Simpan password</button>
      {{#unless forced}}<a class="btn btn-secondary" href="/admin">Batal</a>{{/unless}}
    </div>
  </form>
</div>
