<div class="page-head">
  <div class="page-head-text">
    <h1 class="page-title">Halo, {{admin.name}}</h1>
    <p class="page-subtitle">{{roleNames}} · ringkasan Store Kompas.com hari ini</p>
  </div>
  {{#if perms.stok.edit}}
  <div class="page-actions">
    <a class="btn btn-ghost" href="/admin/stok/masuk">{{icon "arrow-square-in" size=18}} Barang masuk</a>
  </div>
  {{/if}}
</div>

{{#if cards.length}}
<div class="summary-cards-wrap">
<div class="summary-cards">
  {{#each cards}}
  <section class="summary-card" aria-labelledby="ringkasan-{{key}}">
    <div class="summary-card-head">
      <div>
        <h2 class="summary-card-label" id="ringkasan-{{key}}">{{label}}</h2>
        <p class="summary-card-value">{{number value}}</p>
      </div>
      <span class="summary-card-icon" aria-hidden="true">{{icon this.icon size=24}}</span>
    </div>
    {{#if sub}}<p class="summary-card-sub" title="{{subTitle}}">{{sub}}</p>{{/if}}
    <ul class="summary-card-dots">
      {{#each dots}}
      <li{{#if title}} title="{{title}}"{{/if}}><a href="{{href}}"><span class="dot dot-{{tone}}" aria-hidden="true"></span>{{number count}} {{label}}</a></li>
      {{/each}}
    </ul>
    <div class="summary-card-actions">
      <a class="btn btn-secondary btn-sm summary-card-view" href="{{viewHref}}">{{viewLabel}}</a>
      {{#if newHref}}<a class="btn btn-primary btn-sm btn-icon btn-circle" href="{{newHref}}" aria-label="{{newLabel}}" title="{{newLabel}}">{{icon "plus" size=18 weight="bold"}}</a>{{/if}}
    </div>
  </section>
  {{/each}}
</div>
</div>
{{/if}}

<div class="grid grid-2">
  {{#if perms.stok.view}}
  <section class="box">
    <div class="box-head">
      <div>
        <h2 class="box-title">Stok menipis</h2>
        <p class="box-desc">{{number lowCount}} SKU dengan stok tersedia di bawah ambang</p>
      </div>
      <a class="btn btn-plain btn-sm" href="/admin/stok?status=menipis">Lihat semua</a>
    </div>
    {{#if lowStock.length}}
    <ul class="list">
      {{#each lowStock}}
      <li>
        <div class="list-main">
          <strong>{{title}}</strong>
          <span class="small muted mono">{{sku}}</span>
        </div>
        {{#if (lte available 0)}}<span class="badge badge-error">Habis</span>{{else}}<span class="badge badge-warning">Sisa {{available}}</span>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="empty">{{icon "check-circle" size=40}}<strong>Stok aman</strong><span>Tidak ada SKU di bawah ambang.</span></div>
    {{/if}}
  </section>
  {{/if}}

  {{#if perms.pesanan.view}}
  <section class="box">
    <div class="box-head">
      <div>
        <h2 class="box-title">Pesanan terbaru</h2>
        <p class="box-desc">5 pesanan yang paling baru masuk</p>
      </div>
      <a class="btn btn-plain btn-sm" href="/admin/pesanan?status=semua">Lihat semua</a>
    </div>
    {{#if recentOrders.length}}
    <ul class="list recent-orders">
      {{#each recentOrders}}
      <li>
        <span class="recent-order-icon" title="{{fulfillment.label}}">{{icon fulfillment.icon size=20}}</span>
        <div class="list-main">
          <a href="/admin/pesanan/{{invoiceNo}}"><strong class="mono">{{invoiceNo}}</strong></a>
          <span class="small muted">{{buyerName}} · {{_count.items}} barang · <span class="nowrap">{{datetime createdAt}}</span></span>
        </div>
        <div class="recent-order-side">
          <strong>{{rupiah total}}</strong>
          <span class="badge badge-{{status.tone}}">{{status.label}}</span>
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="empty">{{icon "receipt" size=40}}<strong>Belum ada pesanan</strong><span>Pesanan baru akan muncul di sini.</span></div>
    {{/if}}
  </section>
  {{else if perms.produk.view}}
  <section class="box">
    <div class="box-head">
      <div>
        <h2 class="box-title">Draft & terjadwal</h2>
        <p class="box-desc">Produk yang belum tampil di store</p>
      </div>
      <a class="btn btn-plain btn-sm" href="/admin/produk?status=draft">Lihat semua</a>
    </div>
    {{#if scheduled.length}}
    <ul class="list">
      {{#each scheduled}}
      <li>
        <div class="list-main">
          <a href="/admin/produk/{{id}}"><strong>{{title}}</strong></a>
          <span class="small muted">Diubah {{datetime updatedAt}}</span>
        </div>
        {{#if isScheduled}}<span class="badge badge-info">{{date publishedAt}}</span>{{else}}<span class="badge">Draft</span>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="empty">{{icon "files" size=40}}<strong>Tidak ada draft</strong><span>Semua produk sudah tayang atau diarsipkan.</span></div>
    {{/if}}
  </section>
  {{/if}}

  {{#if perms.promo.view}}
  <section class="box">
    <div class="box-head">
      <div>
        <h2 class="box-title">Promo aktif</h2>
        <p class="box-desc">Dipakai checkout mulai Tahap 3</p>
      </div>
      <a class="btn btn-plain btn-sm" href="/admin/promo">Lihat semua</a>
    </div>
    {{#if promos.length}}
    <ul class="list">
      {{#each promos}}
      <li>
        <div class="list-main">
          <a href="/admin/promo/{{id}}"><strong class="mono">{{code}}</strong></a>
          <span class="small muted">{{#if (eq type "PERCENT")}}{{value}}%{{else}}{{rupiah value}}{{/if}}{{#if endsAt}} · sampai {{date endsAt}}{{/if}}</span>
        </div>
        {{#if notStarted}}<span class="badge badge-info">Terjadwal</span>{{else if endingSoon}}<span class="badge badge-warning">Segera berakhir</span>{{else}}<span class="badge badge-success">Aktif</span>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="empty">{{icon "ticket" size=40}}<strong>Belum ada promo aktif</strong></div>
    {{/if}}
  </section>
  {{/if}}

  <section class="box">
    <div class="box-head">
      <div>
        <h2 class="box-title">{{#if changesAll}}Perubahan terakhir{{else}}Perubahan terakhir Anda{{/if}}</h2>
        <p class="box-desc">Dari log perubahan CMS</p>
      </div>
      <a class="btn btn-plain btn-sm" href="/admin/log">Lihat log</a>
    </div>
    {{#if changes.length}}
    <ul class="list">
      {{#each changes}}
      <li>
        <div class="list-main">
          <strong>{{actionLabel}} {{entityName}}{{#if entityLabel}}: {{entityLabel}}{{/if}}</strong>
          <span class="small muted">{{actorEmail}} · {{datetime createdAt}}</span>
        </div>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <div class="empty">{{icon "clock-counter-clockwise" size=40}}<strong>Belum ada perubahan</strong></div>
    {{/if}}
  </section>
</div>
