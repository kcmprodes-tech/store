<div class="page-head">
  <div class="page-head-text">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/admin/pengguna">Pengguna CMS</a>{{icon "caret-right" size=12}}<span>{{user.email}}</span></nav>
    <h1 class="page-title">{{pageTitle}}</h1>
  </div>
</div>

<section class="box narrow">
  <div class="alert alert-warning">{{icon "key" weight="fill"}}<div class="alert-body">
    <p><strong>Password sementara hanya ditampilkan sekali.</strong> Sampaikan langsung ke {{user.name}} lewat jalur yang aman (bukan grup chat).</p>
  </div></div>
  <div class="form-grid mt-16">
    <div class="field">
      <span class="label">Email</span>
      <p class="mono">{{user.email}}</p>
    </div>
    <div class="field">
      <label class="label" for="temp-password">Password sementara</label>
      <div class="row">
        <input class="input mono temp-password" id="temp-password" value="{{password}}" readonly>
        <button class="btn btn-secondary" type="button" data-copy="temp-password">{{icon "copy" size=18}} Salin</button>
      </div>
      <p class="help">Wajib diganti saat login pertama di /admin.</p>
    </div>
  </div>
  <div class="row mt-24">
    <a class="btn btn-primary" href="/admin/pengguna">Selesai</a>
  </div>
</section>
