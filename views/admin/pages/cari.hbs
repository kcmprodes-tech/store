<div class="page-head">
  <div class="page-head-text">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/admin">Dashboard</a>{{icon "caret-right" size=12}}<span>Pencarian</span></nav>
    <h1 class="page-title">Pencarian</h1>
    {{#if text}}<p class="page-subtitle">{{number total}} hasil untuk "{{text}}"</p>{{/if}}
  </div>
</div>

<div class="dashboard-search">{{> search-box q=q}}</div>

{{#if tooShort}}
<div class="alert alert-warning" role="status">{{icon "info" weight="fill"}}<div class="alert-body"><p>Ketik minimal {{minQuery}} karakter.</p></div></div>
{{else if text}}
  {{#if groups.length}}
  <div class="stack">
    {{#each groups}}
    <section class="box" aria-labelledby="hasil-{{key}}">
      <div class="box-head">
        <h2 class="box-title search-result-title" id="hasil-{{key}}">{{icon this.icon size=20}} {{label}} <span class="count">{{number total}}</span></h2>
        {{#if moreHref}}{{#if (gt total items.length)}}<a class="btn btn-plain btn-sm" href="{{moreHref}}">Lihat semua di {{label}}</a>{{/if}}{{/if}}
      </div>
      <ul class="list search-results">
        {{#each items}}
        <li>
          <a class="search-result" href="{{href}}">
            {{#if image}}<img class="thumb thumb-sm" src="{{image}}" alt="" loading="lazy">{{else}}<span class="search-result-icon" aria-hidden="true">{{icon ../this.icon size=18}}</span>{{/if}}
            <span class="list-main">
              <strong>{{highlight title @root.text}}</strong>
              {{#if subtitle}}<span class="small muted">{{highlight subtitle @root.text}}</span>{{/if}}
            </span>
            {{#if badge}}<span class="badge badge-{{badge.tone}}">{{badge.label}}</span>{{/if}}
          </a>
        </li>
        {{/each}}
      </ul>
    </section>
    {{/each}}
  </div>
  {{else}}
  <section class="box"><div class="empty">{{icon "magnifying-glass" size=40}}<strong>Tidak ada hasil untuk "{{text}}"</strong><span>Coba no invoice, nama atau 4 digit HP pembeli, no resi, nama produk, SKU, atau kode promo.</span></div></section>
  {{/if}}
{{else}}
<section class="box"><div class="empty">{{icon "magnifying-glass" size=40}}<strong>Cari apa saja di CMS</strong><span>Pesanan (invoice, pembeli, HP, resi), produk & SKU, kategori, promo, koleksi, seksi, banner, dan pengguna CMS sesuai akses Anda.</span></div></section>
{{/if}}
