<table role="presentation" class="e-items" width="100%" cellpadding="0" cellspacing="0" border="0">
  {{#each order.items}}
  <tr><td colspan="3" class="e-divider">&nbsp;</td></tr>
  <tr>
    <td class="e-item-img-td" width="64"><a href="{{url}}"><img class="e-item-img" src="{{image}}" width="64" height="64" alt=""></a></td>
    <td class="e-item-body">
      <a class="e-item-title" href="{{url}}">{{title}}</a>
      {{#if variant}}<span class="e-item-meta">{{variant}}</span>{{/if}}
      <span class="e-item-meta">{{qty}} × {{rupiah price}}</span>
    </td>
    <td class="e-item-total">{{rupiah lineTotal}}</td>
  </tr>
  {{/each}}
  <tr><td colspan="3" class="e-divider">&nbsp;</td></tr>
</table>
