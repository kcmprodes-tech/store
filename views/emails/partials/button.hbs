<table role="presentation" class="e-btn-table" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="e-btn-cell">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
        <td class="e-btn-td" align="center" bgcolor="#0F79C6"><a class="e-btn" href="{{href}}">{{label}}</a></td>
      </tr></table>
    </td>
    {{#if secondaryHref}}
    <td class="e-btn-gap">&nbsp;</td>
    <td class="e-btn-cell">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
        <td class="e-btn-td--secondary" align="center" bgcolor="#FFFFFF"><a class="e-btn e-btn--secondary" href="{{secondaryHref}}">{{secondaryLabel}}</a></td>
      </tr></table>
    </td>
    {{/if}}
  </tr>
</table>
