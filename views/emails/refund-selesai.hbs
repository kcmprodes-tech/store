{{> badge tone="success" label="Refund selesai"}}
<h1 class="e-title">Dana sudah dikembalikan</h1>
<p class="e-text">Refund untuk pesanan <strong>{{order.invoiceNo}}</strong> sudah kami kirim. Waktu dana masuk bisa berbeda tergantung bank atau e-wallet.</p>
<table role="presentation" class="e-highlight" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="e-highlight-td">
  <div class="e-hl-row"><span class="e-label">Jumlah refund</span><span class="e-value-price">{{rupiah refund.amount}}</span></div>
  <div class="e-hl-row"><span class="e-label">Dikembalikan ke</span><span class="e-value">{{refund.destination}}</span></div>
  <div class="e-hl-row"><span class="e-label">Tanggal</span><span class="e-value">{{refund.doneAt}}</span></div>
  <div class="e-hl-row-last"><span class="e-label">No. referensi</span><span class="e-value">{{refund.reference}}</span></div>
</td></tr></table>
{{> button href=order.url label="Lihat detail pesanan"}}
