{{> badge tone="warning" label="Segera bayar"}}
<h1 class="e-title">Batas bayar tinggal 3 jam lagi</h1>
<p class="e-text">Hai {{customer.name}}, pesanan <strong>{{order.invoiceNo}}</strong> belum dibayar. Selesaikan sebelum <strong>{{payment.deadline}}</strong>, setelah itu pesanan dibatalkan otomatis.</p>
<table role="presentation" class="e-highlight" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="e-highlight-td">
  {{#if (eq payment.method "VA")}}
  <div class="e-hl-row"><span class="e-label">Nomor {{order.paymentMethod}}</span><span class="e-value-lg">{{payment.vaNumber}}</span></div>
  {{/if}}
  <div class="e-hl-row-last"><span class="e-label">Total pembayaran</span><span class="e-value-price">{{rupiah order.total}}</span></div>
</td></tr></table>
{{> button href=order.payUrl label="Bayar sekarang"}}
{{> order_summary hideTotals=true}}
