<div class="store-v2-content">
<main class="cart-page kompas-container py-6">
      <nav class="pdp-breadcrumb checkout-breadcrumb cart-breadcrumb" aria-label="Breadcrumb">
        <a href="https://www.kompas.com/">Beranda</a> <span>/</span> <a href="/">Store</a> <span>/</span> <span>Keranjang</span>
      </nav>
      <h1>Keranjang</h1>
      <p class="cart-page-instruction">Pilih keranjang Belanja atau Langganan sesuai produk yang ingin kamu beli.</p>
      <div class="cart-layout">
        <div class="cart-main">
          <section class="cart-card cart-list-card">
            <div class="cart-list-header">
              <label class="cart-check-row">
                <input type="checkbox" data-cart-select-all="" checked="">
                <span>Pilih Semua</span>
              </label>
              <button type="button" data-cart-delete-selected="">Hapus</button>
            </div>
            <div class="checkout-order-body">
              <div class="checkout-product-list">
                <div class="checkout-product-row cart-checkout-row">
                  <label class="cart-item-check" aria-label="Pilih Bundling #DemamBola Tabloid Soccer dan Kompas.com"><input type="checkbox" data-cart-select-item="cart-1" checked=""></label>
                  <div class="checkout-product-main">
                    <img src="/images/store-v2/product-demam-bola.jpg" alt="Bundling #DemamBola Tabloid Soccer dan Kompas.com">
                    <div>
                      <h3>Bundling #DemamBola Tabloid Soccer dan Kompas.com</h3>
                      <div class="checkout-product-variant">Varian: Bundling</div>
                      <div class="checkout-product-meta"><strong>Rp&nbsp;95.000</strong></div>
                    </div>
                  </div>
                  <div class="checkout-quantity-control"><div class="pdp-quantity checkout-quantity"><button type="button" data-cart-qty-action="decrease" aria-label="Kurangi"><svg class="h-4 w-4 qty-ico-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path></svg><svg class="h-4 w-4 qty-ico-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"></path><path d="M9 7V4h6v3"></path></svg></button><span>1</span><button type="button" data-cart-qty-action="increase" aria-label="Tambah"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></button></div></div>
                </div>
                <div class="checkout-product-row cart-checkout-row">
                  <label class="cart-item-check" aria-label="Pilih Kaus Halaman Depan Kompas - Pilih Tanggal Koran Sesukamu"><input type="checkbox" data-cart-select-item="cart-3" checked=""></label>
                  <div class="checkout-product-main">
                    <img src="/images/store-v2/product-kaus-kompas.png" alt="Kaus Halaman Depan Kompas - Pilih Tanggal Koran Sesukamu">
                    <div>
                      <h3>Kaus Halaman Depan Kompas - Pilih Tanggal Koran Sesukamu</h3>
                      <div class="checkout-product-variant">Varian: Fisik</div>
                      <div class="checkout-product-meta"><strong>Rp&nbsp;199.000</strong></div>
                    </div>
                  </div>
                  <div class="checkout-quantity-control"><div class="pdp-quantity checkout-quantity"><button type="button" data-cart-qty-action="decrease" aria-label="Kurangi"><svg class="h-4 w-4 qty-ico-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path></svg><svg class="h-4 w-4 qty-ico-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"></path><path d="M9 7V4h6v3"></path></svg></button><span>1</span><button type="button" data-cart-qty-action="increase" aria-label="Tambah"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></button></div></div>
                </div>
              </div>
            </div>
          </section>
          <div class="sv2-empty sv2-cart-empty" data-cart-empty hidden>
            <img class="sv2-empty-img" src="/images/store-v2/empty-products.png" alt="" width="320" height="219">
            <div class="sv2-empty-body">
              <p class="sv2-empty-text">Belum ada produk di keranjang</p>
              <a class="sv2-empty-btn" href="/">Belanja lagi</a>
            </div>
          </div>
        </div>

        <aside class="cart-sidebar">
          <div class="sv2-promo" data-promo>
            <button class="sv2-promo-head" type="button" data-promo-toggle aria-expanded="false">
              <span class="sv2-promo-icon"><img src="/images/store-v2/promo-coupon.png" alt=""></span>
              <span class="sv2-promo-text"><strong data-promo-title>Gunakan Kode Promo</strong><small data-promo-saving hidden></small></span>
              <span class="sv2-promo-check" data-promo-check hidden><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#039855" d="M12 2.25A9.75 9.75 0 1 0 21.75 12 9.76 9.76 0 0 0 12 2.25Zm4.28 8.03-5.25 5.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 1 1 1.06-1.06l1.72 1.72 4.72-4.72a.75.75 0 0 1 1.06 1.06Z"/></svg></span>
              <svg class="sv2-promo-chevron" width="20" height="20" aria-hidden="true" viewBox="0 0 256 256" fill="#94A3B8"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"/></svg>
            </button>
            <div class="sv2-promo-body" data-promo-body hidden>
              <div class="sv2-promo-form">
                <span class="sv2-promo-field"><input type="text" placeholder="Masukkan kode" autocomplete="off" spellcheck="false" aria-label="Kode promo" data-promo-input><span class="sv2-promo-field-check" data-promo-field-check hidden><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#039855" d="M12 2.25A9.75 9.75 0 1 0 21.75 12 9.76 9.76 0 0 0 12 2.25Zm4.28 8.03-5.25 5.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 1 1 1.06-1.06l1.72 1.72 4.72-4.72a.75.75 0 0 1 1.06 1.06Z"/></svg></span></span>
                <button class="sv2-promo-btn" type="button" data-promo-apply disabled>Gunakan</button>
              </div>
              <p class="sv2-promo-error" data-promo-error role="alert" hidden>Kode tidak dapat digunakan</p>
            </div>
          </div>
          <section class="cart-card cart-summary">
            <h2>Ringkasan Belanja</h2>
            <div class="cart-summary-lines">
              <div><span>Total Harga (2 Barang)</span><strong>Rp&nbsp;294.000</strong></div>
              <div><span>Total Diskon</span><strong class="is-discount">-Rp&nbsp;0</strong></div>
            </div>
            <div class="cart-summary-total">
              <span>Total Tagihan</span>
              <strong>Rp&nbsp;294.000</strong>
            </div>
            <a class="btn btn-primary w-full" href="/checkout?product=category-bundling-1&amp;type=Bundling&amp;types=Bundling,Fisik,Digital&amp;cartItems=cart-1,cart-3&amp;cartTab=belanja&amp;checkoutFlow=cart" data-cart-checkout="cart-1">Beli (2)</a>
          </section>
        </aside>
      </div>

      <section class="cart-recommendations">
        <div class="section-title">
          <h2>Mungkin Kamu Suka</h2>
        </div>
        <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
          {{#each storev2.related}}{{> product_card_v2}}{{/each}}
        </div>
      </section>
    </main>        </div>
