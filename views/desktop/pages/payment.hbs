<div class="store-v2-content">
<main class="checkout-page kompas-container py-6">
      <nav class="pdp-breadcrumb checkout-breadcrumb" aria-label="Breadcrumb">
        <a href="https://www.kompas.com/">Beranda</a> <span>/</span> <a href="/">Store</a> <span>/</span> <span>Checkout</span>
      </nav>
      <div class="checkout-heading">
        <div>
          <h1>Checkout</h1>
          <p>Lengkapi pesanan kamu di Store Kompas.com.</p>
        </div>
      </div>
      <div class="checkout-grid">
        <div class="checkout-main">
          <section class="checkout-card checkout-order-card">
            <div class="checkout-store-row">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.5"></circle><circle cx="18" cy="20" r="1.5"></circle><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h8.5a2 2 0 0 0 1.9-1.4L22 8H7"></path></svg>
              <div><h2>Pesananmu</h2></div>
            </div>
            <div class="checkout-order-body">
            <div class="checkout-product-list">
              <div class="checkout-product-row">
                <div class="checkout-product-main">
                  <img src="/images/store-v2/product-pesta-bola-premium.png" alt="Bundling Pesta Bola: Tabloid Bola by Kompas Edisi Pesta Bola Amerika 2026 + Akses Kompas Digital Premium">
                  <div>
                    <h3>Bundling Pesta Bola: Tabloid Bola by Kompas Edisi Pesta Bola Amerika 2026 + Akses Kompas Digital Premium</h3>
                    <div class="checkout-product-variant">Varian: Bundling Premium</div>
                    <div class="checkout-product-meta">
                      <strong>Rp&nbsp;50.000</strong>
                      <span class="checkout-price-old">Rp&nbsp;100.000</span>
                      <span class="badge badge-soft-red">50%</span>
                    </div>
                  </div>
                </div>
                <div class="checkout-quantity-control">
                  <div class="pdp-quantity checkout-quantity">
                    <button type="button" data-cart-qty-action="decrease" aria-label="Kurangi"><svg class="h-4 w-4 qty-ico-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path></svg><svg class="h-4 w-4 qty-ico-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"></path><path d="M9 7V4h6v3"></path></svg></button>
                    <span>1</span>
                    <button type="button" data-cart-qty-action="increase" aria-label="Tambah"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></button>
                  </div>
                </div>
                <label class="checkout-note">
                  <span class="checkout-note-control">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                    <input type="text" placeholder="Tambah catatan">
                  </span>
                </label>
              </div>
              <div class="checkout-product-row">
                <div class="checkout-product-main">
                  <img src="/images/store-v2/product-kaus-kompas.png" alt="Kaus Kompas.com Edisi Spesial Jernih Melihat Dunia">
                  <div>
                    <h3>Kaus Kompas.com Edisi Spesial Jernih Melihat Dunia</h3>
                    <div class="checkout-product-variant">Varian: Ukuran L</div>
                    <div class="checkout-product-meta">
                      <strong>Rp&nbsp;150.000</strong>
                    </div>
                  </div>
                </div>
                <div class="checkout-quantity-control">
                  <div class="pdp-quantity checkout-quantity">
                    <button type="button" data-cart-qty-action="decrease" aria-label="Kurangi"><svg class="h-4 w-4 qty-ico-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path></svg><svg class="h-4 w-4 qty-ico-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M6 7l1 13a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1l1-13"></path><path d="M9 7V4h6v3"></path></svg></button>
                    <span>1</span>
                    <button type="button" data-cart-qty-action="increase" aria-label="Tambah"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"></path><path d="M5 12h14"></path></svg></button>
                  </div>
                </div>
                <label class="checkout-note">
                  <span class="checkout-note-control">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>
                    <input type="text" placeholder="Tambah catatan">
                  </span>
                </label>
              </div>
            </div>
            </div>
          </section>

          <section class="checkout-card">
            <div class="checkout-card-title">
              <h2 class="checkout-title-label"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5Z"></path><path d="M3 8l9 5 9-5"></path><path d="M12 13v8"></path></svg> Opsi pengiriman</h2>
            </div>
            <div class="checkout-shipping-options" data-shipping-options>
              <label class="checkout-ship-option">
                <input type="radio" name="shipping" value="kurir" data-shipping="kurir">
                <span class="checkout-ship-body"><strong>Kirim melalui kurir</strong><small>Perlu pilih opsi pengiriman</small></span>
              </label>
              <label class="checkout-ship-option">
                <input type="radio" name="shipping" value="pickup" data-shipping="pickup">
                <span class="checkout-ship-body"><strong>Ambil di tempat</strong><small>Senin-Jumat Pukul 09.00-17.00</small></span>
              </label>
            </div>
          </section>

          <section class="checkout-card" data-address-section hidden>
            <div class="checkout-card-title">
              <h2 class="checkout-title-label"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3z"></path><path d="M14 10h4l3 3v3h-7z"></path><circle cx="7" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg> Alamat Pengiriman</h2>
            </div>
            <button class="checkout-address checkout-address-empty" type="button" data-address-empty-add>
              <div>
                <p>Belum ada Alamat pengiriman</p>
                <span>Tambahkan alamat untuk proses pengiriman</span>
              </div>
              <svg class="h-4 w-4" aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg>
            </button>
          </section>

          <section class="checkout-card" data-courier-section hidden>
            <div class="checkout-card-title">
              <h2 class="checkout-title-label"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h11v10H3z"></path><path d="M14 10h4l3 3v3h-7z"></path><circle cx="7" cy="18" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg> Pilih pengiriman</h2>
            </div>
            <div class="checkout-methods checkout-methods-flat checkout-courier-list">
              <label class="checkout-method checkout-courier">
                <input type="radio" name="courier" value="jne-premium" data-courier>
                <span class="checkout-method-logo"><img src="/images/store-v2/logo-jne.png" alt="JNE"></span>
                <span class="checkout-method-label">JNE Premium</span>
                <span class="checkout-courier-price">Rp12.000</span>
              </label>
              <label class="checkout-method checkout-courier">
                <input type="radio" name="courier" value="jne-regular" data-courier>
                <span class="checkout-method-logo"><img src="/images/store-v2/logo-jne.png" alt="JNE"></span>
                <span class="checkout-method-label">JNE Regular</span>
                <span class="checkout-courier-price">Rp9.000</span>
              </label>
            </div>
          </section>

          <section class="checkout-card" data-pickup-section hidden>
            <div class="checkout-card-title">
              <h2 class="checkout-title-label"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.5-6.5-10a6.5 6.5 0 0 1 13 0c0 4.5-6.5 10-6.5 10Z"></path><circle cx="12" cy="11" r="2.3"></circle></svg> Lokasi pengambilan</h2>
            </div>
            <div class="checkout-pickup">
              <p class="checkout-pickup-name">Kantor KOMPAS.com</p>
              <p class="checkout-pickup-addr">Kompas Gramedia, Jl. Palmerah Sel. No.22-26 Unit 2 Lantai 2, RT.4/RW.2, Gelora, Kecamatan Tanah Abang, Kota Jakarta Pusat, Daerah Khusus Ibukota Jakarta 10270</p>
              <a class="checkout-pickup-map" href="https://www.google.com/maps/search/?api=1&amp;query=Kompas%20Gramedia%20Jl.%20Palmerah%20Selatan%20No.22-26%20Gelora%20Tanah%20Abang%20Jakarta%20Pusat%2010270" target="_blank" rel="noopener noreferrer">Lihat di maps <svg viewBox="0 0 256 256" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M224,104a8,8,0,0,1-16,0V59.32l-66.33,66.34a8,8,0,0,1-11.32-11.32L196.68,48H152a8,8,0,0,1,0-16h64a8,8,0,0,1,8,8Zm-40,24a8,8,0,0,0-8,8v72H48V80h72a8,8,0,0,0,0-16H48A16,16,0,0,0,32,80V208a16,16,0,0,0,16,16H176a16,16,0,0,0,16-16V136A8,8,0,0,0,184,128Z"/></svg><span class="sr-only"> (buka di tab baru)</span></a>
            </div>
          </section>

          <section class="checkout-card">
            <div class="checkout-card-title">
              <h2 class="checkout-title-label"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2"></rect><path d="M2.5 9.5h19"></path></svg> Metode pembayaran</h2>
            </div>
            <div class="checkout-methods checkout-methods-flat">
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="cc"><span class="checkout-method-label">Kartu kredit</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-kartu-kredit.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="gopay"><span class="checkout-method-label">GoPay</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-gopay.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="ovo"><span class="checkout-method-label">OVO</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-ovo.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="shopeepay"><span class="checkout-method-label">ShopeePay</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-shopeepay.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="dana"><span class="checkout-method-label">Dana</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-dana.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="linkaja"><span class="checkout-method-label">LinkAja</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-linkaja.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="astrapay"><span class="checkout-method-label">Astra Pay</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-astrapay.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="bca-va"><span class="checkout-method-label">Virtual Account BCA</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-bca.png" alt=""></span></label>
              <label class="checkout-method"><input type="radio" name="paymentMethod" value="qris"><span class="checkout-method-label">QRIS</span><span class="checkout-method-logo"><img src="/images/store-v2/pay-qris.png" alt=""></span></label>
            </div>
          </section>
        </div>

        <aside class="checkout-sidebar">
          <div class="sv2-promo" data-promo>
            <button class="sv2-promo-head" type="button" data-promo-toggle aria-expanded="false">
              <span class="sv2-promo-icon"><img src="/images/store-v2/promo-coupon.png" alt=""></span>
              <span class="sv2-promo-text"><strong data-promo-title>Gunakan Kode Promo</strong><small data-promo-saving hidden></small></span>
              <span class="sv2-promo-check" data-promo-check hidden><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#039855" d="M12 2.25A9.75 9.75 0 1 0 21.75 12 9.76 9.76 0 0 0 12 2.25Zm4.28 8.03-5.25 5.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 1 1 1.06-1.06l1.72 1.72 4.72-4.72a.75.75 0 0 1 1.06 1.06Z"/></svg></span>
              <svg class="sv2-promo-chevron" width="20" height="20" aria-hidden="true" viewBox="0 0 256 256" fill="#94A3B8"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"/></svg>
            </button>
            <div class="sv2-promo-body" data-promo-body hidden>
              <div class="sv2-promo-form">
                <span class="sv2-promo-field"><input type="text" placeholder="Masukkan kode" autocomplete="off" spellcheck="false" aria-label="Kode promo" data-promo-input><span class="sv2-promo-field-check" data-promo-field-check hidden><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="#039855" d="M12 2.25A9.75 9.75 0 1 0 21.75 12 9.76 9.76 0 0 0 12 2.25Zm4.28 8.03-5.25 5.25a.75.75 0 0 1-1.06 0l-2.25-2.25a.75.75 0 1 1 1.06-1.06l1.72 1.72 4.72-4.72a.75.75 0 0 1 1.06 1.06Z"/></svg></span></span>
                <button class="sv2-promo-btn" type="button" data-promo-apply disabled>Gunakan</button>
              </div>
              <p class="sv2-promo-error" data-promo-error role="alert" hidden>Kode tidak dapat digunakan</p>
            </div>
          </div>
          <section class="checkout-summary">
            <div class="checkout-summary-title">
              <h2>Ringkasan Transaksi</h2>
            </div>
            <div class="checkout-summary-lines">
              <div><span>Subtotal produk</span><strong>{{checkout.subtotal}}</strong></div>
              <div><span>Pengiriman</span><strong>{{checkout.shipping}}</strong></div>
              {{#if checkout.protectionFee}}<div><span>Proteksi paket</span><strong>{{checkout.protectionFee}}</strong></div>{{/if}}
              <div data-promo-line hidden><span>Diskon promo</span><strong class="is-discount" data-promo-amount>-Rp&nbsp;0</strong></div>
            </div>
            <div class="checkout-total">
              <span>Total</span>
              <strong>{{checkout.total}}</strong>
            </div>
            <button class="btn btn-primary w-full" type="button" data-pay-now="" disabled>Bayar Sekarang</button>
            <p>Dengan melanjutkan, kamu menyetujui syarat &amp; ketentuan bertransaksi di Store Kompas.com.</p>
          </section>
        </aside>
      </div>
      <!-- video premium checkout (?product=<video id>): digital, no Opsi pengiriman -->
      <script type="application/json" data-video-data>{{{json storev2.video}}}</script>
    </main>        </div>
