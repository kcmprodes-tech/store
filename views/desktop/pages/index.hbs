<div class="store-v2-content">
    <main>
      
        <section class="hero-full" aria-label="Promo Store Kompas.com" data-hero-carousel="">
      <div class="hero-carousel">
        <div class="hero-carousel-track" style="transform: translateX(0%);">
          {{#each storev2.hero}}
          <article class="hero-slide">
            <a class="hero-slide-link" href="{{href}}" aria-label="{{title}}">
              <img src="{{image}}" alt="{{title}}" class="hero-slide-image">
            </a>
          </article>
          {{/each}}
        </div>
      </div>
      <button class="hero-arrow hero-arrow-left" type="button" data-carousel="prev" aria-label="Slide sebelumnya"><svg class="h-5 w-5 rotate-180" aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg></button>
      <button class="hero-arrow hero-arrow-right" type="button" data-carousel="next" aria-label="Slide berikutnya"><svg class="h-5 w-5" aria-hidden="true" viewBox="0 0 256 256" fill="currentColor"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"/></svg></button>
      <div class="hero-dots" aria-label="Pilih slide">
        {{#each storev2.hero}}
        <button class="hero-dot{{#if @first}} is-active{{/if}}" type="button" data-slide-index="{{@index}}" aria-label="Tampilkan slide"></button>
        {{/each}}
      </div>
    </section>
  

      
    <section id="home-categories" class="kompas-container py-8">
      <div class="section-title">
        <h2>Kategori Pilihan</h2>
      </div>
      <div class="sv2-cat-grid">
        <a class="sv2-cat-card" href="/koleksi/diskon"><img class="sv2-cat-icon" src="/images/store-v2/cat-diskon-spesial.png" alt=""><span class="sv2-cat-label">Diskon Spesial</span></a>
        <a class="sv2-cat-card" href="/koleksi/rekomendasi"><img class="sv2-cat-icon" src="/images/store-v2/cat-rekomendasi.png" alt=""><span class="sv2-cat-label">Rekomendasi</span></a>
        <a class="sv2-cat-card" href="/koleksi/terbaru"><img class="sv2-cat-icon" src="/images/store-v2/cat-terbaru.png" alt=""><span class="sv2-cat-label">Terbaru</span></a>
        <a class="sv2-cat-card" href="/koleksi/merchandise"><img class="sv2-cat-icon" src="/images/store-v2/cat-merchandise.png" alt=""><span class="sv2-cat-label">Merchandise</span></a>
        <a class="sv2-cat-card" href="/koleksi/membership"><img class="sv2-cat-icon" src="/images/store-v2/cat-membership.png" alt=""><span class="sv2-cat-label">Membership</span></a>
        <a class="sv2-cat-card" href="/koleksi/event"><img class="sv2-cat-icon" src="/images/store-v2/cat-event.png" alt=""><span class="sv2-cat-label">Event</span></a>
      </div>
    </section>

    <section class="kompas-container py-8">
      <div class="section-title">
        <h2>Terlaris</h2>
        <a class="font-semibold text-[#0f79c6]" href="/koleksi/terlaris">Lihat Semua</a>
      </div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        {{#each storev2.terlaris}}{{> product_card_v2}}{{/each}}
      </div>
    </section>

    <section class="kompas-container py-8">
      <div class="section-title">
        <h2>Rekomendasi untukmu</h2>
        <a class="font-semibold text-[#0f79c6]" href="/koleksi/rekomendasi">Lihat Semua</a>
      </div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        {{#each storev2.rekomendasi}}{{> product_card_v2}}{{/each}}
      </div>
    </section>

    <section class="kompas-container py-8">
      <div class="section-title">
        <h2>Merchandise pilihan</h2>
        <a class="font-semibold text-[#0f79c6]" href="/koleksi/merchandise">Lihat Semua</a>
      </div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        {{#each storev2.merchandise}}{{> product_card_v2}}{{/each}}
      </div>
    </section>

    <section class="kompas-container py-8">
      <div class="section-title">
        <h2>Baru di store</h2>
        <a class="font-semibold text-[#0f79c6]" href="/koleksi/terbaru">Lihat Semua</a>
      </div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-4">
        {{#each storev2.baru}}{{> product_card_v2}}{{/each}}
      </div>
      <div class="sv2-section-more"><a class="btn btn-secondary sv2-more-btn" href="/koleksi/terbaru">Lihat semua</a></div>
    </section>

    </main>
        </div>
